# ─── Alpha VPN Backend ───────────────────────────────
# این فایل رو به .env کپی کن و مقادیر رو عوض کن

# آدرس دیتابیس — پیش‌فرض SQLite (برای production میتونی PostgreSQL بذاری)
DATABASE_URL=sqlite:///./alphavpn.db
# DATABASE_URL=postgresql://user:password@localhost:5432/alphavpn

# کلید مخفی JWT — حتماً عوض کن!
SECRET_KEY=super-secret-key-change-this-now-minimum-32-chars

# مدت اعتبار توکن (روز)
TOKEN_EXPIRE_DAYS=30

# کلید دسترسی ادمین — برای endpoint های /api/admin
ADMIN_KEY=change-admin-key-now

# پورت اجرا
PORT=8000

# محیط اجرا
ENV=production
